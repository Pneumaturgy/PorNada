[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform float Height = 120;
uniform float WindParameter = 0.05000000074506;
uniform float ShakeStrengthParameter = 25;
uniform vec4 ColorParameter : source_color = vec4(0.525377, 0.301334, 0.000001, 1.000000);



void vertex() {
// Input:2
	vec2 n_out2p0 = VERTEX;
	float n_out2p2 = n_out2p0.g;


// FloatParameter:17
	float n_out17p0 = Height;


// Input:5
	float n_out5p0 = TIME;


// Input:13
	float n_out13p0 = TIME;


// FloatParameter:15
	float n_out15p0 = WindParameter;


// FloatOp:12
	float n_out12p0 = n_out13p0 * n_out15p0;


// FloatFunc:14
	float n_out14p0 = sin(n_out12p0);


// FloatOp:10
	float n_out10p0 = n_out5p0 * n_out14p0;


// FloatFunc:7
	float n_out7p0 = sin(n_out10p0);


// FloatParameter:16
	float n_out16p0 = ShakeStrengthParameter;


// FloatOp:8
	float n_out8p0 = n_out7p0 * n_out16p0;


// VectorCompose:6
	float n_in6p1 = 0.00000;
	float n_in6p2 = 0.00000;
	vec3 n_out6p0 = vec3(n_out8p0, n_in6p1, n_in6p2);


	vec3 n_out4p0;
// If:4
	float n_in4p2 = 0.00001;
	vec3 n_in4p3 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_in4p4 = vec3(0.00000, 0.00000, 0.00000);
	if(abs(n_out2p2 - n_out17p0) < n_in4p2)
	{
		n_out4p0 = n_in4p3;
	}
	else if(n_out2p2 < n_out17p0)
	{
		n_out4p0 = n_out6p0;
	}
	else
	{
		n_out4p0 = n_in4p4;
	}


// VectorOp:3
	vec2 n_out3p0 = n_out2p0 + vec2(n_out4p0.xy);


// ColorParameter:11
	vec4 n_out11p0 = ColorParameter;


// Output:0
	VERTEX = n_out3p0;
	COLOR.rgb = vec3(n_out11p0.xyz);


}
