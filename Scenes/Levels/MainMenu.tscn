[sub_resource type="GDScript" id="GDScript_j122v"]
script/source = "extends Node2D
@onready var animation_player = $FadeInScreen/AnimationPlayer
@onready var color_rect = $FadeInScreen/ColorRect
@onready var fade_in_screen = $FadeInScreen

var trigger = false
# Called when the node enters the scene tree for the first time.
func _ready():
	fade_in_screen.visible =  true


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta):
	pass


func _on_play_pressed():
	print('yes')
	animation_player.play_backwards(\"fade_in\")
	color_rect.visible = true
	trigger = true
	




func _on_quit_pressed():
	get_tree().quit()


func _on_animation_player_animation_finished(fade_in):
	if trigger:
		get_tree().change_scene_to_file(\"res://Scenes/Levels/Main.tscn\")
"

[sub_resource type="GDScript" id="GDScript_eu2ia"]
script/source = "extends Camera2D

var is_mobile = false


func _ready():
	set_process_input(true)
	if OS.get_name() == \"Android\":
		is_mobile = true

func _process(delta):
	if is_mobile:
		var gyro = Input.get_gyroscope()
		position += Vector2(-gyro.y*15,-gyro.x*15)

func _input(event):
	if event is InputEventMouseMotion:
		position = event.position
	
"

