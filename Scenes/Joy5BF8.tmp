script/source = "extends TouchScreenButton
class_name MobileJoystick

var vector = Vector2(0,0)
var joystick_active = false
var active_touch_id = -1
var is_at_circumference = false

@onready var marker = $Marker

## Are you touching the button?
func _input(event):
	if event is InputEventScreenTouch:
		if event.pressed:
			active_touch_id = event.index
			print(active_touch_id)
			joystick_active = true
			print(joystick_active)
			if event is InputEventScreenDrag or InputEventScreenTouch:
				marker.position = event.position
				print(marker.position)
		else:
			if active_touch_id != -1:
				active_touch_id = -1
				print(active_touch_id)
			if joystick_active:
				joystick_active = false
				print(joystick_active)
	
	

