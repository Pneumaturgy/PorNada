[sub_resource type="GDScript" id="GDScript_fysrj"]
script/source = "extends TouchScreenButton
class_name MobileJoystick

var vector = Vector2(0,0)
var joystick_active = false
var active_touch_id = -1
var is_at_circumference = false

@onready var marker = $Marker



## If not, return the marker to its center.
func _physics_process(delta):
	#print(active_touch_id)
	if !joystick_active:
		print(\"move back...\")
		marker.global_position = lerp(marker.global_position, self.global_position+Vector2(64,64), delta*10)

func calculate_vector(event_position):
	#var texture_center = event_position + Vector2(64,64)
	#return (event_position - texture_center).normalized()
	return event_position.normalized()

"

